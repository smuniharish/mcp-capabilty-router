# Settings for the examples that need a model, embeddings, a service, or Node.js.
# Copy this file to .env, fill in what you need, and load it when running an example:
#
#   uv run --env-file .env python examples/10_agent_middleware.py
#
# Examples whose variable is empty are skipped by scripts/run_examples.py.

# Chat model for examples 10, 11, 12, and 23, as "provider:model", such as openai:gpt-5.4-mini.
MCP_ROUTER_EXAMPLE_MODEL=

# Model name for example 22, which uses the OpenAI SDK directly, such as gpt-5.4-mini.
MCP_ROUTER_EXAMPLE_OPENAI_MODEL=

# Embedding model for examples 08 and 18, such as openai:text-embedding-3-small.
MCP_ROUTER_EXAMPLE_EMBEDDINGS=

# PostgreSQL database for example 13, such as postgresql://user:password@localhost:5432/db.
MCP_ROUTER_EXAMPLE_POSTGRES_DSN=

# Set to 1 to run example 14, which launches an official MCP server with npx.
MCP_ROUTER_EXAMPLE_NODE=

# Dedicated Redis database for example 17, such as redis://localhost:6379/0.
MCP_ROUTER_EXAMPLE_REDIS_URL=

# Qdrant server for example 18, such as http://localhost:6333.
MCP_ROUTER_EXAMPLE_QDRANT_URL=

# Browser for example 24, which drives Playwright's MCP server, such as chromium or msedge.
MCP_ROUTER_EXAMPLE_BROWSER=

# Optional OTLP collector for example 16. Unset for in-memory inspection.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set true only for a trusted local collector without TLS.
OTEL_EXPORTER_OTLP_INSECURE=false

# Credentials of your model provider, read by its SDK or LangChain integration.
OPENAI_API_KEY=
# Optional: the base URL of an OpenAI-compatible endpoint.
OPENAI_BASE_URL=
