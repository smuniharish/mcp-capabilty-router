# Environment template. Copy to .env and fill in real values; .env is git-ignored.
#
# mcp-capability-router does not define its own model configuration surface.
# Instantiate whichever LangChain-compatible chat model class your application already
# uses (ChatOpenAI, ChatLiteLLM, ChatAnthropic, ...) directly in code, and configure it
# with that class's own constructor arguments or the environment variables it documents.
#
# Example (see examples/create_agent_routing.py):
#   from langchain_openai import ChatOpenAI
#   model = ChatOpenAI(model="gpt-5.6-luna", base_url=..., api_key=...)

# Used by the ChatOpenAI-based examples in this repository.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-5.6-luna

# Optional MCP application settings (adapt to your transport/client).
MCP_SERVER_NAME=filesystem
MCP_SERVER_COMMAND=npx
MCP_SERVER_ROOT=